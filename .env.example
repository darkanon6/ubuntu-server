# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Dashboard login (auth added in build step 4)
DASHBOARD_USERNAME=changeme
DASHBOARD_PASSWORD=changeme

# Random secret used to sign session cookies — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=changeme

# Netdata API this server proxies system stats from
NETDATA_URL=http://localhost:19999
