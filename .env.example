# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Dashboard login (auth added in build step 4)
DASHBOARD_USERNAME=changeme
DASHBOARD_PASSWORD=changeme

# Random secret used to sign session cookies — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=changeme

# Netdata API this server proxies system stats from. Netdata is published
# on the *host's* network, not reachable via the host's own hostname from
# inside a container (that resolves to 127.0.1.1, the container's own
# loopback) — use host.docker.internal, set up via extra_hosts in
# docker-compose.yml.
NETDATA_URL=http://host.docker.internal:19999
